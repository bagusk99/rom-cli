#!/usr/bin/env bash
# rom-remote — runs rom on the Mac worker (ssh mac) and pulls the files back.
#
# Usage:
#   rom-remote -p switch "mario kart"
#   ROM_REMOTE_HOST=mac rom-remote -y "zelda"
set -euo pipefail

HOST="${ROM_REMOTE_HOST:-mac}"
REMOTE_DIR="${ROM_REMOTE_DIR:-$HOME/Downloads/roms}"
LOCAL_DIR="${ROM_DIR:-$HOME/Downloads/roms}"

if [ "$#" -eq 0 ]; then
  echo "usage: rom-remote [-p platform] \"game name\""
  exit 1
fi

ARGS=""
for a in "$@"; do
  ARGS="$ARGS $(printf '%q' "$a")"
done

SSH_TTY=""
[ -t 0 ] && SSH_TTY="-t"

echo "→ running on the worker ($HOST)…"
# shellcheck disable=SC2086
ssh $SSH_TTY "$HOST" "~/bin/rom$ARGS"

echo "← syncing $HOST:$REMOTE_DIR → $LOCAL_DIR"
mkdir -p "$LOCAL_DIR"
rsync -az --ignore-existing "$HOST:$REMOTE_DIR/" "$LOCAL_DIR/" && echo "✔ synced"
